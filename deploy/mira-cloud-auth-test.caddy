test.cloud-auth.tomzlab.cn {
  @api path /health /ready /v1/*
  handle @api {
    reverse_proxy 127.0.0.1:8788
  }

  # Keep the temporary OPS-006 acceptance harness reachable until the real
  # Account Portal flow replaces it. handle_path strips this prefix before
  # proxying, so its relative /v1 requests continue to work unchanged.
  handle_path /_acceptance/* {
    reverse_proxy 127.0.0.1:8788
  }

  handle {
    root * /opt/cloud-auth-test/web
    try_files {path} /index.html
    header {
      Cache-Control "no-store"
      Content-Security-Policy "default-src 'self'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
      Referrer-Policy "same-origin"
      X-Content-Type-Options "nosniff"
      X-Frame-Options "DENY"
    }
    file_server
  }
}
