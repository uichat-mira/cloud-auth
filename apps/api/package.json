{
  "name": "@uichat-mira/cloud-auth-api",
  "version": "0.0.0",
  "private": true,
  "description": "Mira Cloud Auth API service",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "check": "pnpm run typecheck && pnpm run test",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate-cli.ts",
    "admin:dev": "tsx --env-file-if-exists=../../.env src/admin-cli.ts",
    "admin": "node dist/admin-cli.js",
    "benchmark:argon2": "node scripts/benchmark-argon2.mjs",
    "backup": "node scripts/backup.mjs",
    "seed:dev": "node scripts/seed-dev-account.mjs"
  },
  "dependencies": {
    "@uichat-mira/cloud-auth-contracts": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^5.0.5"
  }
}
