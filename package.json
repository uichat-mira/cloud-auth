{
  "name": "@uichat-mira/cloud-auth",
  "version": "0.0.0",
  "private": true,
  "description": "Mira Cloud shared identity service",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "pnpm --filter @uichat-mira/cloud-auth-api run dev",
    "build": "pnpm --filter @uichat-mira/cloud-auth-api run build",
    "start": "pnpm --filter @uichat-mira/cloud-auth-api run start",
    "typecheck": "pnpm --filter @uichat-mira/cloud-auth-api run typecheck",
    "test": "pnpm --filter @uichat-mira/cloud-auth-api run test",
    "test:unit": "pnpm --filter @uichat-mira/cloud-auth-api run test:unit",
    "test:contract": "pnpm --filter @uichat-mira/cloud-auth-api run test:contract",
    "test:integration": "pnpm --filter @uichat-mira/cloud-auth-api run test:integration",
    "check": "pnpm run typecheck && pnpm run test",
    "db:migrate": "pnpm --filter @uichat-mira/cloud-auth-api run db:migrate",
    "admin:dev": "pnpm --filter @uichat-mira/cloud-auth-api run admin:dev",
    "admin": "pnpm --filter @uichat-mira/cloud-auth-api run admin",
    "benchmark:argon2": "pnpm --filter @uichat-mira/cloud-auth-api run benchmark:argon2",
    "backup": "pnpm --filter @uichat-mira/cloud-auth-api run backup"
  }
}
