HOST=0.0.0.0
PORT=8788
MIRA_AUTH_DB_PATH=./data/auth.sqlite
LOG_LEVEL=info

# Cloud Session engineering policy; not a product-visible timer.
MIRA_AUTH_SESSION_TTL_SECONDS=2592000

# OPS-016 first-party OAuth authorization code lifetime (60-600 seconds).
MIRA_AUTH_OAUTH_CODE_TTL_SECONDS=300

# OPS-018 Desktop Host presence lease (30-3600 seconds). A Host becomes
# unavailable when this lease is not refreshed; it is not a reachability probe.
MIRA_AUTH_HOST_LEASE_SECONDS=120

# OPS-020 Host grant snapshot validity (30-3600 seconds). Desktop must fail
# closed when a cached snapshot passes validUntil or cannot be refreshed.
MIRA_AUTH_HOST_GRANT_SNAPSHOT_TTL_SECONDS=300

# Login resource controls for the initial 2 vCPU / 2 GiB host.
MIRA_AUTH_PASSWORD_MAX_CONCURRENCY=2
MIRA_AUTH_LOGIN_PER_USERNAME_PER_MINUTE=5
MIRA_AUTH_LOGIN_PER_IP_PER_MINUTE=20

# Argon2id V0 baseline. Do not lower below reviewed security policy.
MIRA_AUTH_ARGON2_MEMORY_KIB=19456
MIRA_AUTH_ARGON2_PASSES=2
MIRA_AUTH_ARGON2_PARALLELISM=1

# OPS-008 service-credential signing. Unset means issuance/JWKS fail closed
# while login, health, readiness, and device management stay available.
# Never commit private key material. Verification-only keys are PUBLIC PEMs:
# use this list to pre-publish the NEXT public key before switching the signer,
# and to retain the OLD public key during retirement. Private PEMs are rejected.
# MIRA_AUTH_SERVICE_CREDENTIAL_ACTIVE_KID=cloud-auth-YYYY-MM
# MIRA_AUTH_SERVICE_CREDENTIAL_ACTIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# MIRA_AUTH_SERVICE_CREDENTIAL_RETIRING_PUBLIC_KEYS={"cloud-auth-YYYY-MM":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
# MIRA_AUTH_SERVICE_CREDENTIAL_TTL_SECONDS=300

# Local development only. `pnpm run dev` / `dev:api` load the repository-root
# .env when it exists (gitignored), and `pnpm run seed:dev` creates or resets
# this account from it. Nothing here is read by production deployments.
# The password policy requires at least 15 characters.
MIRA_AUTH_DEV_API_ORIGIN=http://127.0.0.1:8788
# MIRA_AUTH_SEED_USERNAME=mira
# MIRA_AUTH_SEED_PASSWORD=change-me-local-only-15+
