HOST=0.0.0.0
PORT=8788
MIRA_AUTH_DB_PATH=./data/auth.sqlite
LOG_LEVEL=info

# Cloud Session engineering policy; not a product-visible timer.
MIRA_AUTH_SESSION_TTL_SECONDS=2592000

# Login resource controls for the initial 2 vCPU / 2 GiB host.
MIRA_AUTH_PASSWORD_MAX_CONCURRENCY=2
MIRA_AUTH_LOGIN_PER_USERNAME_PER_MINUTE=5
MIRA_AUTH_LOGIN_PER_IP_PER_MINUTE=20

# Argon2id V0 baseline. Do not lower below reviewed security policy.
MIRA_AUTH_ARGON2_MEMORY_KIB=19456
MIRA_AUTH_ARGON2_PASSES=2
MIRA_AUTH_ARGON2_PARALLELISM=1

# Test-only browser acceptance harness. Keep false in production.
MIRA_AUTH_ACCEPTANCE_UI=false
